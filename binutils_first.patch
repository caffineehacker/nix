--- a/pkgs/build-support/bintools-wrapper/default.nix
+++ b/pkgs/build-support/bintools-wrapper/default.nix
@@ -440,6 +440,22 @@
         "${bintools_bin}/bin/${targetPrefix}ranlib"
     ''
 
+    + optionalString (
+      isGNU
+      && (targetPlatform.gcc.lto or false)
+      && (targetPlatform == hostPlatform)
+      && !(bintools.passthru.isFromBootstrapFiles or bintools.passthru.isFromMinBootstrap or false)
+      && !(lib.strings.hasInfix "bootstrap" (toString runtimeShell))
+    ) ''
+      cat <<'EOF' > $out/nix-support/post-link-hook
+      if [[ -z "''${NIX_LINK_TYPE_${suffixSalt}:-}" && -e "''${linkerOutput:-}" ]]; then
+        if (( "''${relocatable:-0}" )) || [[ " ''${params[*]:-} " == *" -r "* || " ''${params[*]:-} " == *" --relocatable "* ]]; then
+          "${bintools_bin}/bin/${targetPrefix}objcopy" -R '.gnu.lto_*' -R '.gnu.debuglto_*' "$linkerOutput" 2>/dev/null || true
+        fi
+      fi
+      EOF
+    ''
+
     ##
     ## Extra custom steps
     ##
--- a/pkgs/build-support/cc-wrapper/default.nix
