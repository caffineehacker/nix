       (targetPlatform.isPower64 && targetPlatform.isBigEndian) && isClang && !(targetPlatform ? gcc.cpu)
-    ) "-mno-altivec";
+    ) "-mno-altivec"
+    ++ optionals (
+      isGNU
+      && (targetPlatform.gcc.lto or false)
+      && (targetPlatform == hostPlatform)
