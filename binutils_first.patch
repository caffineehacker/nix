   defaultHardeningFlags = bintools.defaultHardeningFlags or [ ];
@@ -1013,6 +1023,20 @@
         substituteAll ${./add-clang-cc-cflags-before.sh} $out/nix-support/add-local-cc-cflags-before.sh
       ''
     )
+
+    + optionalString (
+      isGNU
+      && (targetPlatform.gcc.lto or false)
+      && (targetPlatform == hostPlatform)
+      && !(lib.strings.hasInfix "bootstrap" name)
+      && !(cc.passthru.isFromBootstrapFiles or cc.passthru.isFromMinBootstrap or cc.passthru.isXgcc or false)
+    ) ''
+      cat <<'EOF' >> $out/nix-support/add-local-cc-cflags-before.sh
